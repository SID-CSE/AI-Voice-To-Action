# Clerk authentication.
# The publishable key is used by the browser; the secret key must stay server-side.
# Leave both blank to use the automatic guest demo scope.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-side Gemini API key. Without it, the safe local heuristic analyzer is used.
GEMINI_API_KEY=

# Neon PostgreSQL pooled connection string for shared persistence.
# Leave blank to use local JSON storage during development.
DATABASE_URL=

# Vercel Blob read/write token for knowledge-base file uploads.
# Keep this server-side and never expose it with a VITE_ prefix.
BLOB_READ_WRITE_TOKEN=

# Runtime configuration.
PORT=3000
NODE_ENV=development

# Local JSON fallback storage. Used only when DATABASE_URL is blank.
DATA_DIR=./data
DB_FILE=./data/store.json
