# Required for durable production data. Optional for local development.
# Server-only. Required for all Vercel deployments so data and rate limits persist.
DATABASE_URL=

# Server-only. Optional; enables Gemini-backed analysis. Heuristic fallback is used otherwise.
GEMINI_API_KEY=

# Server-only. Optional; needed only for public guest file uploads to Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Clerk keys: set all three together to enable private user accounts. The publishable keys are client-safe.
# VITE_CLERK_PUBLISHABLE_KEY is embedded in the browser and is not a secret.
VITE_CLERK_PUBLISHABLE_KEY=
# Server configuration (not secret). Same value as VITE_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=
# Server-only. Never prefix this with VITE_ or commit a real value.
CLERK_SECRET_KEY=

# Local development only. Vercel supplies its own runtime settings.
PORT=3000
NODE_ENV=development
DATA_DIR=./data
DB_FILE=./data/local-store.json
