# Optional Clerk keys. Set both to enable verified per-user Neon scopes.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-side Gemini API key. Without it, the built-in safe demo heuristic is used.
GEMINI_API_KEY=

# Neon pooled connection string. Create the app_state table from db/schema.sql
# or let the application create it on first startup.
DATABASE_URL=

# Vercel Blob token used by the hosted file upload endpoint.
BLOB_READ_WRITE_TOKEN=

# Local-only fallback data directory. Ignored when DATABASE_URL is configured.
DATA_DIR=./data
