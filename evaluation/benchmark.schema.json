{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actionflow.example/schemas/benchmark-1.0.json",
  "title": "ActionFlow Evaluation Annotation",
  "type": "object",
  "required": ["schemaVersion", "caseId", "split", "source", "tasks", "uncertaintyLabels", "risk", "annotation"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "caseId": { "type": "string", "minLength": 1 },
    "split": { "enum": ["train", "validation", "test"] },
    "source": {
      "type": "object",
      "required": ["dataset", "license", "meetingId", "transcript"],
      "properties": {
        "dataset": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "meetingId": { "type": "string", "minLength": 1 },
        "transcript": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "uncertaintyLabels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk": {
      "type": "object",
      "required": ["level", "confirmationRequired", "categories"],
      "properties": {
        "level": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "confirmationRequired": { "type": "boolean" },
        "categories": {
          "type": "array",
          "items": { "enum": ["financial", "communication", "deletion", "security", "legal", "general"] }
        }
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": ["annotatorIds", "adjudicated"],
      "properties": {
        "annotatorIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "adjudicated": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "required": ["start", "end", "text"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["task", "owner", "deadline", "evidence", "ownerStatus", "deadlineStatus"],
      "properties": {
        "task": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "deadline": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "taskSpan": { "$ref": "#/$defs/span" },
        "ownerSpan": { "$ref": "#/$defs/span" },
        "deadlineSpan": { "$ref": "#/$defs/span" },
        "evidenceSpan": { "$ref": "#/$defs/span" },
        "ownerStatus": { "enum": ["explicit", "resolved_from_context", "unknown"] },
        "deadlineStatus": { "enum": ["explicit", "relative", "unknown"] }
      },
      "additionalProperties": false
    }
  }
}
